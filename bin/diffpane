#!/usr/bin/env bash
# diffpane: live list + inline diff of files Claude changed since HEAD.
# Run it in a pane or window next to Claude Code; where is up to you (README
# has tmux bindings). See DESIGN.md.

# Follow symlinks (installed as a link on PATH) to find lib/.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case "$link" in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
lib="$(cd "$(dirname "$self")/../lib" && pwd)"
case "$1" in
  -h | --help) sed -n '2,3s/^# \{0,1\}//p' "$self"; exit 0 ;;
esac
. "$lib/common.sh"

dp_init "$PWD" || { echo "diffpane: not inside a git work tree" >&2; exit 1; }
cd "$DP_ROOT" || exit 1
sock=$(dp_sock)
mkdir -p "${sock%/*}" && chmod 700 "${sock%/*}"

if [ -S "$sock" ] && curl -s --max-time 1 --unix-socket "$sock" http://localhost >/dev/null 2>&1; then
  echo "diffpane: already running for $DP_ROOT" >&2
  exit 1
fi

echo on > "$DP_STATE/follow"
echo off > "$DP_STATE/wrap"
echo turns > "$DP_STATE/view"
rows=$("$DP_LIB/list")
if [ -n "$rows" ]; then printf '%s\n' "$rows" > "$DP_STATE/view.list"; else : > "$DP_STATE/view.list"; fi

# Ticker: catches commits and edits made outside Claude, and theme switches.
# fzf can't change colors while running, so on a switch it saves the focused
# file and quits fzf; the loop below starts a new one. Stops when this script exits.
restart="$DP_STATE/view.restart"
(
  theme=$(dp_theme)
  while sleep 3 && kill -0 $$ 2>/dev/null; do
    action='transform($DP_LIB/on-change {1} {3})'
    now=$(dp_theme)
    [ "$now" = "$theme" ] || { theme=$now; action='execute-silent(printf "%s\t%s" {1} {3} > "$DP_STATE/view.restart")+abort'; }
    curl -s --max-time 1 --unix-socket "$sock" http://localhost -d "$action" >/dev/null 2>&1
  done
) &
ticker=$!
trap 'kill $ticker 2>/dev/null' EXIT

# Terminal title (OSC 2): tmux takes it as the pane title, which the README's
# toggle binding looks for; other terminals show it on the tab or window.
printf '\033]2;Diffpane\033\\'

rm -f "$restart"
while :; do
  # After a theme restart, keep the row the user was on (follow picks its own).
  refocus="load:ignore"
  if [ -f "$restart" ] && [ "$(cat "$DP_STATE/follow")" != on ]; then
    idx=$(awk -F'\t' 'NR == FNR { p = $1; t = $2; next } $1 == p && $3 == t { print FNR; exit }' \
      "$restart" "$DP_STATE/view.list")
    [ -n "$idx" ] && refocus="load:pos($idx)+unbind(load)"  # once, after input is read
  fi
  rm -f "$restart"
  # header:-1 lets the header's own ANSI styling show. Light defaults are too
  # dark (bg+ 251) or olive (info 101: preview scroll indicator).
  colors="$(dp_theme),header:-1"
  [ "$(dp_theme)" = light ] && colors="$colors,bg+:#eaeef2,info:#6e7781"
  fzf < "$DP_STATE/view.list" \
    --listen="$sock" \
    --ansi --no-input --no-sort --layout=reverse --info=hidden --color="$colors" \
    --header-border=bottom --pointer='' --marker='' --gutter=' ' \
    --delimiter='\t' --with-nth=2 \
    --preview '$DP_LIB/preview {1} {3}' \
    --preview-window 'right,70%,border-left' \
    --bind 'start:transform-header($DP_LIB/header)' \
    --bind "$refocus" \
    --bind 'result:transform-header($DP_LIB/header)' \
    --bind 'resize:transform-header($DP_LIB/header)+transform($DP_LIB/on-change {1} {3} --force)' \
    --bind 'focus:transform($DP_LIB/on-focus {n} {1} {3})' \
    --bind 'j:down,k:up' \
    --bind 'ctrl-d:preview-half-page-down,ctrl-u:preview-half-page-up' \
    --bind 'f:transform($DP_LIB/toggle-follow)' \
    --bind 'w:transform($DP_LIB/toggle-wrap)' \
    --bind 'v:transform($DP_LIB/toggle-view {1} {3})' \
    --bind 'r:transform($DP_LIB/on-change {1} {3} --force)' \
    --bind 'enter:ignore,double-click:ignore' \
    --bind 'q:abort'
  [ -f "$restart" ] || break
done
