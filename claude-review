#!/usr/bin/env bash
# claude-review: live list + inline diff of files Claude changed since HEAD.
# See ~/.config/claude-review/DESIGN.md.
. "$(dirname "$0")/lib/common.sh"

cr_init "$PWD" || { echo "claude-review: not inside a git work tree" >&2; exit 1; }
cd "$CR_ROOT" || exit 1
sock=$(cr_sock)
mkdir -p "${sock%/*}" && chmod 700 "${sock%/*}"

if [ -S "$sock" ] && curl -s --max-time 1 --unix-socket "$sock" http://localhost >/dev/null 2>&1; then
  echo "claude-review: already running for $CR_ROOT" >&2
  exit 1
fi

echo on > "$CR_STATE/follow"
rows=$("$CR_LIB/list")
if [ -n "$rows" ]; then printf '%s\n' "$rows" > "$CR_STATE/view.list"; else : > "$CR_STATE/view.list"; fi

# Ticker: catches commits and edits made outside Claude, and theme switches.
# fzf can't change colors while running, so on a switch it saves the focused
# file and quits fzf; the loop below starts a new one. Stops when this script exits.
restart="$CR_STATE/view.restart"
(
  theme=$(cr_theme)
  while sleep 3 && kill -0 $$ 2>/dev/null; do
    action='transform($CR_LIB/on-change {1})'
    now=$(cr_theme)
    [ "$now" = "$theme" ] || { theme=$now; action='execute-silent(printf %s {1} > "$CR_STATE/view.restart")+abort'; }
    curl -s --max-time 1 --unix-socket "$sock" http://localhost -d "$action" >/dev/null 2>&1
  done
) &
ticker=$!
trap 'kill $ticker 2>/dev/null' EXIT

if [ -n "$TMUX" ]; then
  # Editor and file as separate args: tmux runs them without a shell, so a
  # name like posts.$id.tsx is not expanded.
  open='execute-silent(tmux new-window -c "$CR_ROOT" ${EDITOR:-nvim} {1})'
else
  open='execute(${EDITOR:-nvim} {1})'
fi

rm -f "$restart"
while :; do
  # After a theme restart, keep the file the user was on (follow picks its own).
  refocus="load:ignore"
  if [ -f "$restart" ] && [ "$(cat "$CR_STATE/follow")" != on ]; then
    idx=$(awk -F'\t' -v p="$(cat "$restart")" '$1 == p { print NR; exit }' "$CR_STATE/view.list")
    [ -n "$idx" ] && refocus="load:pos($idx)+unbind(load)"  # once, after input is read
  fi
  rm -f "$restart"
  colors=$(cr_theme)
  [ "$colors" = light ] && colors="light,bg+:#eaeef2"  # default light bg+ (251) is too dark
  fzf < "$CR_STATE/view.list" \
    --listen="$sock" \
    --ansi --no-input --no-sort --layout=reverse --info=hidden --color="$colors" \
    --delimiter='\t' --with-nth=2 \
    --preview '$CR_LIB/preview {1}' \
    --preview-window 'right,70%,border-left' \
    --bind 'start:transform-header($CR_LIB/header)' \
    --bind "$refocus" \
    --bind 'result:transform-header($CR_LIB/header)' \
    --bind 'focus:transform($CR_LIB/on-focus {n} {1})' \
    --bind 'j:down,k:up' \
    --bind 'ctrl-d:preview-half-page-down,ctrl-u:preview-half-page-up' \
    --bind 'f:transform($CR_LIB/toggle-follow)' \
    --bind 'r:transform($CR_LIB/on-change {1} --force)' \
    --bind "enter:$open" \
    --bind 'q:abort'
  [ -f "$restart" ] || break
done
