#!/usr/bin/env bash
# Claude Code hook entry point: UserPromptSubmit, PreToolUse, PostToolUse,
# PostToolUseFailure, Stop. Records which files Claude changed, however it
# changed them. Must never block, fail or print.
. "$(dirname "$0")/../lib/common.sh"

READONLY_TOOLS=" Read Grep Glob LS WebFetch WebSearch TodoWrite ToolSearch Skill AskUserQuestion TaskCreate TaskGet TaskList TaskUpdate TaskOutput "

main() {
  local event tool id cwd pre tree
  # "-" placeholders: tab is IFS whitespace, so empty fields would collapse.
  IFS=$'\t' read -r event tool id cwd <<EOF
$(jq -r '[.hook_event_name // "-", .tool_name // "-", .tool_use_id // "-", .cwd // "-"] | @tsv')
EOF
  case "$READONLY_TOOLS" in *" $tool "*) return 0 ;; esac
  # Bad input must not fall back to the hook's own cwd (`git -C ""` is a no-op).
  [ -n "$cwd" ] && [ "$cwd" != - ] && [ -d "$cwd" ] || return 0
  cdiff_init "$cwd" || return 0

  cdiff_lock
  cdiff_sync_head
  case "$event" in
    UserPromptSubmit)
      echo $(($(cdiff_turn) + 1)) > "$CDIFF_STATE/turn"
      cdiff_snapshot > "$CDIFF_STATE/t0"
      ;;
    PreToolUse)
      cdiff_snapshot > "$CDIFF_STATE/pre/$id"
      ;;
    PostToolUse | PostToolUseFailure)
      if [ -s "$CDIFF_STATE/pre/$id" ]; then
        pre=$(cat "$CDIFF_STATE/pre/$id")
        tree=$(cdiff_snapshot)
        [ -n "$tree" ] && cdiff_git diff --name-only --no-renames -z "$pre" "$tree" | cdiff_record "$(cdiff_turn)"
      fi
      rm -f "$CDIFF_STATE/pre/$id"
      ;;
    Stop)
      tree=$(cdiff_snapshot)
      if [ -s "$CDIFF_STATE/t0" ] && [ -n "$tree" ]; then
        cdiff_git diff --name-only --no-renames -z "$(cat "$CDIFF_STATE/t0")" "$tree" | cdiff_record_new "$(cdiff_turn)"
      fi
      [ -n "$tree" ] && echo "$tree" > "$CDIFF_STATE/t0"
      ;;
  esac
  cdiff_unlock

  case "$event" in PostToolUse | PostToolUseFailure | Stop) cdiff_ping ;; esac
}

main >/dev/null 2>&1
exit 0
