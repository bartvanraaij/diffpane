#!/usr/bin/env bash
# Viewer header: repo, view and follow state; turn and changed-file count; empty-state hint.
# Counts are right-aligned to the list column.
. "$(dirname "$0")/common.sh"

dp_init "$PWD" || exit 0
B=$'\033[1m' D=$'\033[2m' G=$'\033[32m' Y=$'\033[33m' N=$'\033[0m'
# view.list: file rows have a path, the dividers between turns don't. Turns
# view lists a file once per turn; Files view has no dividers, so its turns are
# counted from the log: those that changed a listed file.
if [ "$(cat "$DP_STATE/view" 2>/dev/null)" = files ]; then
  view="≡"
  set -- $(awk -F'\t' 'FILENAME == ARGV[1] { if ($1 != "") listed[$1] = 1; next }
    $2 in listed && !($1 in t) { t[$1] = 1; d++ } END { print length(listed), d + 0 }' \
    "$DP_STATE/view.list" "$DP_STATE/touched" 2>/dev/null)
else
  view="↩"
  set -- $(awk -F'\t' '$1 != "" && !($1 in f) { f[$1] = 1; n++ } $1 == "" { d++ }
    END { print n + 0, n ? d + 1 : 0 }' "$DP_STATE/view.list" 2>/dev/null)
fi
n=${1:-0} turns=${2:-0}
[ "$n" -eq 1 ] && files="1 file changed" || files="$n files changed"
[ "$turns" -eq 1 ] && turns="1 turn" || turns="$turns turns"
# follow state: on ●, paused ⏸, off ○ (one column wide)
case "$(cat "$DP_STATE/follow" 2>/dev/null)" in
  on) follow="${G}●${N}" ;;
  paused) follow="${Y}⏸${N}" ;;
  *) follow="${D}○${N}" ;;
esac

width=$(dp_list_width)
line() {  # <left> <left width> <right> <right width>
  local gap=$((width - $2 - $4))
  [ "$gap" -lt 2 ] && gap=2
  printf '%s%*s%s\n' "$1" "$gap" '' "$3"
}
repo=$(basename "$DP_ROOT")
line "$B$repo$N" "${#repo}" "${D}${view}${N} $follow" 3
if [ "$n" -gt 0 ]; then
  line "$D$turns$N" "${#turns}" "$D$files$N" "${#files}"
  exit 0
fi

# Empty state: the commit everything is compared against, message in full.
printf '\nNo Claude changes since\n'
if ! dp_git rev-parse -q --verify HEAD >/dev/null; then
  printf '%sthe start of the repo%s\n' "$D" "$N"
  exit 0
fi
printf '%s%s%s %s· %s%s\n' "$Y" "$(dp_git log -1 --format=%h)" "$N" "$D" "$(dp_git log -1 --format=%ar)" "$N"
dp_git log -1 --format=%s | fold -s -w "$width" | sed 's/ *$//' | while IFS= read -r l; do printf '%s%s%s\n' "$B" "$l" "$N"; done
# Body without trailers (Co-Authored-By: ...), wrapped, at most 8 lines.
body=$(dp_git log -1 --format=%b | grep -v -i -E '^[a-z-]+-by: ' | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}')
if [ -n "$body" ]; then
  printf '\n'
  printf '%s\n' "$body" | fold -s -w "$width" | sed 's/ *$//' | awk -v D="$D" -v N="$N" \
    'NR <= 8 { print D $0 N } NR == 9 { print D "…" N }'
fi
