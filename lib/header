#!/usr/bin/env bash
# Viewer header: repo and changed-file count, turn count and follow state; empty-state hint.
# Counts are right-aligned to the list column, which is 30% of fzf's width.
. "$(dirname "$0")/common.sh"

cr_init "$PWD" || exit 0
B=$'\033[1m' D=$'\033[2m' G=$'\033[32m' Y=$'\033[33m' N=$'\033[0m'
# view.list: file rows have a path, turn title rows don't.
set -- $(awk -F'\t' '$1 != "" { f++ } $1 == "" { t++ } END { print f + 0, t + 0 }' "$CR_STATE/view.list" 2>/dev/null)
n=${1:-0} turns=${2:-0}
[ "$n" -eq 1 ] && files="1 file changed" || files="$n files changed"
[ "$turns" -eq 1 ] && turns="1 turn" || turns="$turns turns"
# follow text and its visible width (symbols are one column, more bytes)
case "$(cat "$CR_STATE/follow" 2>/dev/null)" in
  on) follow="${G}●${N} following" fw=11 ;;
  paused) follow="${Y}⏸${N} paused" fw=8 ;;
  *) follow="${D}○ follow off${N}" fw=12 ;;
esac

cols=${FZF_COLUMNS:-80}
width=$((cols - cols * 70 / 100 - 1))  # keep the last column free, next to the preview border
line() {  # <left> <left width> <right> <right width>
  local gap=$((width - 1 - $2 - $4))
  [ "$gap" -lt 2 ] && gap=2
  printf ' %s%*s%s\n' "$1" "$gap" '' "$3"
}
repo=$(basename "$CR_ROOT")
line "$B$repo$N" "${#repo}" "$D$files$N" "${#files}"
line "$D$turns$N" "${#turns}" "$follow" "$fw"
if [ "$n" -eq 0 ]; then
  printf ' %sNo Claude changes since %s%s\n' "$D" "$(cr_git log -1 --format='%h %s' 2>/dev/null || echo 'repo start')" "$N"
fi
