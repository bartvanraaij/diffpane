#!/usr/bin/env bash
# Print viewer rows "<path>\t<display>", newest change first.
# Files that no longer differ from HEAD are skipped.
# Runs inside fzf transforms, so it stays at a fixed number of git calls
# regardless of how many files changed.
. "$(dirname "$0")/common.sh"

dp_init "$PWD" || exit 0
dp_lock; dp_sync_head; dp_unlock
[ -s "$DP_STATE/touched" ] || exit 0
cd "$DP_ROOT" || exit 0

base=$(dp_base)
TAB=$(printf '\t')
tmp=$(mktemp -d) || exit 0
trap 'rm -rf "$tmp"' EXIT

# Newest log line per path, newest first: "<line>\t<turn>\t<path>".
awk -F'\t' '{ line[$2] = NR; turn[$2] = $1 }
  END { for (p in line) printf "%d\t%s\t%s\n", line[p], turn[p], p }' "$DP_STATE/touched" |
  sort -t "$TAB" -k1,1nr > "$tmp/rows"

paths=()
while IFS="$TAB" read -r _ _ path; do paths+=("$path"); done < "$tmp/rows"

dp_git ls-tree -r --name-only -z "$base" -- "${paths[@]}" | tr '\0' '\n' > "$tmp/inbase"
dp_git diff --numstat --no-renames -z "$base" -- "${paths[@]}" | tr '\0' '\n' > "$tmp/numstat"
for p in "${paths[@]}"; do
  if [ -e "$p" ] || [ -L "$p" ]; then printf '%s\n' "$p"; fi
done > "$tmp/exists"
seen="$DP_STATE/seen"
[ -f "$seen" ] || seen=/dev/null

# Turns are separated by a divider row with an empty path.
# File row display: "<M|A|D> <+add> <−del>  <name>[ ●]  <dir>", stat columns right-aligned, zeros blank,
# ● = changed since last viewed.
awk -F'\t' -v width="$(dp_list_width)" \
  -v Y=$'\033[33m' -v G=$'\033[32m' -v R=$'\033[31m' -v B=$'\033[34m' -v D=$'\033[2m' -v N=$'\033[0m' '
  function pad(n) { return sprintf("%" n "s", "") }
  FILENAME == ARGV[1] { inbase[$0] = 1; next }
  FILENAME == ARGV[2] { add[$3] = $1; del[$3] = $2; changed[$3] = 1; next }
  FILENAME == ARGV[3] { exists[$0] = 1; next }
  FILENAME == ARGV[4] { seen[$2] = $1; next }
  {
    line = $1; turn = $2; path = $3
    if (path in inbase) {
      if (!(path in changed)) next
      a = add[path]; d = del[path]; st = (path in exists) ? Y "M" : R "D"
    } else {
      if (!(path in exists)) next
      n = 0
      while ((r = (getline l < path)) > 0) n++
      close(path)
      if (r < 0) next
      a = n; d = 0; st = G "A"
    }
    k++; P[k] = path; T[k] = turn; S[k] = st N; A[k] = a; Dl[k] = d
    U[k] = (line > seen[path] + 0) ? " " B "●" N : ""
    if (a + 0 && length(a) > wa) wa = length(a)  # zero counts are left blank;
    if (d + 0 && length(d) > wd) wd = length(d)  # an all-zero column is dropped
  }
  END {
    for (i = 0; i < width; i++) rule = rule "─"
    for (i = 1; i <= k; i++) {
      if (i > 1 && T[i] != T[i - 1]) printf "\t%s%s%s\n", D, rule, N
      name = P[i]; dir = ""
      if (match(P[i], /.*\//)) { dir = "  " D substr(P[i], 1, RLENGTH - 1) N; name = substr(P[i], RLENGTH + 1) }
      ca = !wa ? "" : A[i] + 0 ? " " pad(wa - length(A[i])) G "+" A[i] N : pad(wa + 2)
      cd = !wd ? "" : Dl[i] + 0 ? " " pad(wd - length(Dl[i])) R "−" Dl[i] N : pad(wd + 2)
      printf "%s\t%s%s%s  %s%s%s\n", P[i], S[i], ca, cd, name, U[i], dir
    }
  }' "$tmp/inbase" "$tmp/numstat" "$tmp/exists" "$seen" "$tmp/rows"
