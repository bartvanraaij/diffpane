#!/usr/bin/env bash
# Print viewer rows "<path>\t<display>", newest change first.
# Files that no longer differ from HEAD are skipped.
# Runs inside fzf transforms, so it stays at a fixed number of git calls
# regardless of how many files changed.
. "$(dirname "$0")/common.sh"

cr_init "$PWD" || exit 0
cr_lock; cr_sync_head; cr_unlock
[ -s "$CR_STATE/touched" ] || exit 0
cd "$CR_ROOT" || exit 0

base=$(cr_base)
TAB=$(printf '\t')
tmp=$(mktemp -d) || exit 0
trap 'rm -rf "$tmp"' EXIT

# Newest log line per path, newest first: "<line>\t<turn>\t<path>".
awk -F'\t' '{ line[$2] = NR; turn[$2] = $1 }
  END { for (p in line) printf "%d\t%s\t%s\n", line[p], turn[p], p }' "$CR_STATE/touched" |
  sort -t "$TAB" -k1,1nr > "$tmp/rows"

paths=()
while IFS="$TAB" read -r _ _ path; do paths+=("$path"); done < "$tmp/rows"

cr_git ls-tree -r --name-only -z "$base" -- "${paths[@]}" | tr '\0' '\n' > "$tmp/inbase"
cr_git diff --numstat --no-renames -z "$base" -- "${paths[@]}" | tr '\0' '\n' > "$tmp/numstat"
for p in "${paths[@]}"; do
  if [ -e "$p" ] || [ -L "$p" ]; then printf '%s\n' "$p"; fi
done > "$tmp/exists"
seen="$CR_STATE/seen"
[ -f "$seen" ] || seen=/dev/null

awk -F'\t' \
  -v Y=$'\033[33m' -v G=$'\033[32m' -v R=$'\033[31m' -v C=$'\033[36m' -v D=$'\033[2m' -v N=$'\033[0m' '
  FILENAME == ARGV[1] { inbase[$0] = 1; next }
  FILENAME == ARGV[2] { add[$3] = $1; del[$3] = $2; changed[$3] = 1; next }
  FILENAME == ARGV[3] { exists[$0] = 1; next }
  FILENAME == ARGV[4] { seen[$2] = $1; next }
  {
    line = $1; turn = $2; path = $3; tag = ""
    if (path in inbase) {
      if (!(path in changed)) next
      a = add[path]; d = del[path]
      if (!(path in exists)) tag = "deleted"
    } else {
      if (!(path in exists)) next
      n = 0
      while ((r = (getline l < path)) > 0) n++
      close(path)
      if (r < 0) next
      a = n; d = 0; tag = "new"
    }
    mark = (line > seen[path] + 0) ? Y "●" N : " "
    printf "%s\t%s %s%s%s  %s  %s+%s%s %s−%s%s%s\n", path, mark, D, turn, N, path, G, a, N, R, d, N, (tag != "" ? "  " C tag N : "")
  }' "$tmp/inbase" "$tmp/numstat" "$tmp/exists" "$seen" "$tmp/rows"
