#!/usr/bin/env bash
# fzf focus handler. Usage: on-focus <index> <path> <turn>  (index = fzf's zero-based {n})
# Skips divider rows (empty path) in the direction of travel; pauses follow when
# the user moves off the newest row; marks the focused row (file + turn) seen.
. "$(dirname "$0")/common.sh"

dp_init "$PWD" || exit 0
n="$1" path="$2" turn="$3"
[ -n "$n" ] || exit 0
last=$(cat "$DP_STATE/view.focus" 2>/dev/null)
echo "$n" > "$DP_STATE/view.focus"
if [ -z "$path" ]; then
  if [ "$n" -eq 0 ] || [ "$n" -gt "${last:-0}" ]; then echo down; else echo up; fi
  exit 0
fi
actions=""

if [ "$(cat "$DP_STATE/follow" 2>/dev/null)" = on ] && [ "$n" != 0 ]; then
  echo paused > "$DP_STATE/follow"
  dp_turn > "$DP_STATE/view.paused-turn"  # on-change resumes follow after this turn
  actions='transform-header($DP_LIB/header)'
fi

row=$(awk -F'\t' -v p="$path" -v t="$turn" '$1 == p && $3 == t' "$DP_STATE/view.list" 2>/dev/null)
case "$row" in
  *●*)
    total=$(wc -l < "$DP_STATE/touched" 2>/dev/null | tr -d ' ')
    printf '%s\t%s\t%s\n' "${total:-0}" "$path" "$turn" >> "$DP_STATE/seen"
    more=$("$DP_LIB/on-change" "$path" "$turn")
    [ -n "$more" ] && actions="${actions:+$actions+}$more"
    ;;
esac

[ -n "$actions" ] && echo "$actions"
exit 0
