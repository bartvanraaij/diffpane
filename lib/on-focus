#!/usr/bin/env bash
# fzf focus handler. Usage: on-focus <index> <path>  (index = fzf's zero-based {n})
# Skips divider rows (empty path) in the direction of travel; pauses follow when
# the user moves off the newest row; marks the focused file seen.
. "$(dirname "$0")/common.sh"

cr_init "$PWD" || exit 0
n="$1" path="$2"
[ -n "$n" ] || exit 0
last=$(cat "$CR_STATE/view.focus" 2>/dev/null)
echo "$n" > "$CR_STATE/view.focus"
if [ -z "$path" ]; then
  if [ "$n" -eq 0 ] || [ "$n" -gt "${last:-0}" ]; then echo down; else echo up; fi
  exit 0
fi
actions=""

if [ "$(cat "$CR_STATE/follow" 2>/dev/null)" = on ] && [ "$n" != 0 ]; then
  echo paused > "$CR_STATE/follow"
  cr_turn > "$CR_STATE/view.paused-turn"  # on-change resumes follow after this turn
  actions='transform-header($CR_LIB/header)'
fi

row=$(awk -F'\t' -v p="$path" '$1 == p' "$CR_STATE/view.list" 2>/dev/null)
case "$row" in
  *●*)
    total=$(wc -l < "$CR_STATE/touched" 2>/dev/null | tr -d ' ')
    printf '%s\t%s\n' "${total:-0}" "$path" >> "$CR_STATE/seen"
    more=$("$CR_LIB/on-change" "$path")
    [ -n "$more" ] && actions="${actions:+$actions+}$more"
    ;;
esac

[ -n "$actions" ] && echo "$actions"
exit 0
