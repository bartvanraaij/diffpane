#!/usr/bin/env bash
# Inline diff of one file, rendered by delta. Usage: preview <path> [<turn>]
# With a turn (Turns view): that turn's own change, between its start and end
# snapshots (a fresh snapshot while it runs). Without: against HEAD.
. "$(dirname "$0")/common.sh"

dp_init "$PWD" || exit 0
path="$1"
[ -n "$path" ] || exit 0
turn="$2"
base=$(dp_base)
if [ -n "$turn" ]; then
  IFS=$'\t' read -r _ start end <<EOF
$(dp_turn_ranges | awk -F'\t' -v t="$turn" '$1 == t')
EOF
  [ -n "$start" ] || exit 0
  if [ -z "$end" ]; then dp_lock; end=$(dp_snapshot); dp_unlock; fi
fi

{
  if [ -n "$turn" ]; then
    dp_git --no-pager diff --no-renames "$start" "$end" -- "$path"
  elif dp_git cat-file -e "$base:$path" 2>/dev/null; then
    dp_git --no-pager diff "$base" -- "$path"
  else
    dp_git --no-pager diff --no-index -- /dev/null "$path"
  fi
} | {
  # No file header: the list already shows which file this is.
  set -- --file-style=omit --hunk-header-style=omit \
    --true-color=always --paging=never --width="${FZF_PREVIEW_COLUMNS:-80}"
  if [ "$(dp_theme)" = light ]; then  # GitHub light diff colors
    delta --light "$@" --plus-style='syntax #dafbe1' --plus-emph-style='syntax #aceebb' \
      --minus-style='syntax #ffebe9' --minus-emph-style='syntax #ffcecb'
  else  # strong backgrounds; optional diffpane syntax theme (themes/, see README) is
    # Monokai Extended with lighter comments. Without it delta warns on stderr and
    # falls back to its default, which is Monokai Extended.
    delta --dark "$@" --syntax-theme=diffpane 2>/dev/null \
      --plus-style='syntax #2a6a3a' --plus-emph-style='syntax #3f9a55' \
      --minus-style='syntax #7a2a32' --minus-emph-style='syntax #b03a46'
  fi
} | sed '/./,$!d' | {  # drop leading empty lines
  # Wrapped here, not by fzf: fzf can't indent continuation rows past the gutter.
  if [ "$(cat "$DP_STATE/wrap" 2>/dev/null)" = on ]; then
    "$DP_LIB/wrap" "${FZF_PREVIEW_COLUMNS:-80}"
  else
    cat
  fi
}
