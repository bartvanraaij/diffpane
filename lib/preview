#!/usr/bin/env bash
# Inline diff of one file against HEAD, rendered by delta. Usage: preview <path>
. "$(dirname "$0")/common.sh"

cr_init "$PWD" || exit 0
path="$1"
[ -n "$path" ] || exit 0
base=$(cr_base)

{
  if cr_git cat-file -e "$base:$path" 2>/dev/null; then
    cr_git --no-pager diff "$base" -- "$path"
  else
    cr_git --no-pager diff --no-index -- /dev/null "$path"
  fi
} | if [ "$(cr_theme)" = light ]; then  # GitHub light diff colors
  delta --light --plus-style='syntax #dafbe1' --plus-emph-style='syntax #aceebb' \
    --minus-style='syntax #ffebe9' --minus-emph-style='syntax #ffcecb' \
    --true-color=always --paging=never --width="${FZF_PREVIEW_COLUMNS:-80}"
else  # delta's dark defaults are too faint
  delta --dark --plus-style='syntax #1e4a2c' --plus-emph-style='syntax #2f7040' \
    --minus-style='syntax #5a2328' --minus-emph-style='syntax #8a3038' \
    --true-color=always --paging=never --width="${FZF_PREVIEW_COLUMNS:-80}"
fi
